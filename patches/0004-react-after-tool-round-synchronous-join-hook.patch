+  test "consumer halt cancels the request after the callback round without another model call" do
+    parent = self()
+    :persistent_term.erase({__MODULE__, :llm_call_count})
+
+    # Helper releases the rendezvous tools only once both are provably running;
+    # the cancel signal (sent when the consumer halts) is therefore queued
+    # while the runner is still inside the tool round join.
+    helper =
+      spawn(fn ->
+        running =
+          for _ <- 1..2, reduce: [] do
+            acc ->
+              receive do
+                {:rv_running, tag, pid} -> [{tag, pid} | acc]
+              end
+          end
+
+        # Hold BOTH tools until both are provably blocked, so the round cannot
+        # finish on a single signal while the consumer is still scheduling its
+        # halt/cancel. Cancel is queued strictly before round completion: the
+        # :after_llm checkpoint that triggers the halt is sent before the tasks
+        # spawn, and the round then needs both spawns, signals, releases, join
+        # and reduction to complete.
+        for {tag, pid} <- running do
+          send(pid, {:rv_go, tag})
+        end
+      end)
+
+    Mimic.stub(ReqLLM.Generation, :stream_text, fn model, _messages, _opts ->
+      case next_llm_call() do
+        1 ->
+          {:ok,
+           responses_stream_response(
+             [
+               ReqLLM.StreamChunk.tool_call("rv_slow", %{}, %{id: "x1"}),
+               ReqLLM.StreamChunk.tool_call("rv_fast", %{}, %{id: "x2"})
+             ],
+             %{finish_reason: :tool_calls},
+             model
+           )}
+
+        other ->
+          raise "unexpected llm call #{other} (cancel did not stop the run)"
+      end
+    end)
+
+    config =
+      Config.new(%{
+        model: :capable,
+        tools: %{"rv_slow" => RvSlowTool, "rv_fast" => RvFastTool},
+        request_transformer: RoundSpyTransformer
+      })
+
+    # Pull events until the first :after_llm checkpoint (tool round starting),
+    # then halt: Stream.resource cleanup queues {:react_cancel, ref} before the
+    # round can finish, and awaits runner shutdown without deadlocking because
+    # the helper releases both blocked tools.
+    collected =
+      ReAct.stream("cancel boundary", config, context: %{test_pid: parent, rv_target: helper})
+      |> Enum.reduce_while([], fn event, acc ->
+        acc = [event | acc]
+
+        if event.kind == :checkpoint and event.data.reason == :after_llm do
+          {:halt, acc}
+        else
+          {:cont, acc}
+        end
+      end)
+
+    events = Enum.reverse(collected)
+    assert Enum.any?(events, &(&1.kind == :checkpoint and &1.data.reason == :after_llm))
+
+    # Remaining events (callback ran, then cancellation) arrive as raw messages.
+    assert_receive {:after_tool_round, _, round, _, _, _}, 3_000
+    assert round.iteration == 1
+    assert_receive {:react_runner, _ref, :event, %{kind: :request_cancelled}}, 3_000
+    refute_received {:react_runner, _ref2, :event, %{kind: :llm_started}}
+    assert llm_call_count() == 1
+    refute_receive {:after_tool_round, _, _, _, _, _}, 200
+  end
